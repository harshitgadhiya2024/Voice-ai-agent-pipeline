# Copy to .env via: ./deploy/setup-env.sh
# Only GROQ_API_KEY, SARVAM_API_KEY, and CERTBOT_EMAIL must be set by you.

GROQ_API_KEY=
SARVAM_API_KEY=
CERTBOT_EMAIL=admin@aavishailab.com

FRONTEND_DOMAIN=voice.aavishailab.com
BACKEND_DOMAIN=api.voice.aavishailab.com
BACKEND_PORT=6120

# Filled automatically by deploy/setup-env.sh
CORS_ORIGINS=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
NGINX_CONF_DIR=conf.d.http

NEXT_PUBLIC_AUTO_LISTEN=false
NEXT_PUBLIC_VAD_REDEMPTION_FRAMES=14
NEXT_PUBLIC_SPEECH_END_FLUSH_MS=450
NEXT_PUBLIC_TTS_PLAYBACK_GAP_MS=500
