NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/voice
NEXT_PUBLIC_API_URL=http://localhost:8000

# Continuous VAD while idle (true) vs listen only after TTS / tap-to-speak (false, default)
NEXT_PUBLIC_AUTO_LISTEN=false

# Silence before auto stop (~96ms per frame). Default 14 ≈ 1.3s. Try 18–22 for slower speakers.
NEXT_PUBLIC_VAD_REDEMPTION_FRAMES=14

# Ms to keep mic open after VAD end (flush audio to server). Default 450.
NEXT_PUBLIC_SPEECH_END_FLUSH_MS=450

# Playback gap tolerance between TTS chunks (ms). Default 500.
NEXT_PUBLIC_TTS_PLAYBACK_GAP_MS=500
